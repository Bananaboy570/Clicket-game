rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alexr.t.1157@gmail.com' ||
        request.auth.token.email == '354245082@educ.dpcdsb.org'
      );
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'username', 'text', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'username', 'avatarBlookId', 'achievements', 'isOwner', 'text', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 32 &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 300 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidPresence(data) {
      return data.keys().hasAll(['id', 'userId', 'username', 'lastSeen']) &&
        data.keys().hasOnly(['id', 'userId', 'username', 'avatarBlookId', 'unlockedCount', 'isOwner', 'achievements', 'lastSeen']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.username is string && data.username.size() <= 32 &&
        data.lastSeen is number;
    }

    function isValidTrade(data) {
      return data.keys().hasAll(['id', 'creatorId', 'creatorUsername', 'offeredBlookId', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'creatorId', 'creatorUsername', 'creatorAvatarBlookId', 'creatorAchievements', 'creatorIsOwner', 'offeredBlookId', 'requestedBlookId', 'requestedRarity', 'note', 'status', 'createdAt', 'fulfilledByUsername', 'fulfilledAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.creatorId is string && data.creatorId.size() <= 128 &&
        data.creatorUsername is string && data.creatorUsername.size() <= 32 &&
        data.offeredBlookId is string && data.offeredBlookId.size() <= 64 &&
        (data.status == 'OPEN' || data.status == 'FULFILLED' || data.status == 'CANCELLED') &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'username', 'tokens']) &&
        data.id is string && data.id.size() <= 128 &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 30 &&
        data.tokens is number && data.tokens >= 0;
    }

    // Public lobby chat messages (Real-time Global Chat)
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) && isValidChatMessage(incoming());
      allow update: if false;
      allow delete: if isSystemAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Live online players presence heartbeat
    match /presence/{playerId} {
      allow read: if true;
      allow create, update: if isValidId(playerId) && isValidPresence(incoming());
      allow delete: if isSystemAdmin();
    }

    // Global trading board public offers (Real-time Global Market)
    match /global_trades/{tradeId} {
      allow read: if true;
      allow create: if isValidId(tradeId) && isValidTrade(incoming()) && incoming().status == 'OPEN';
      allow update: if isValidId(tradeId) && isValidTrade(incoming()) && (incoming().status == 'FULFILLED' || incoming().status == 'CANCELLED');
      allow delete: if isSystemAdmin();
    }

    // User account profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isSystemAdmin();
    }
  }
}
