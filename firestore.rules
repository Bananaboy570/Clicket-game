rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSystemAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alexr.t.1157@gmail.com' ||
        request.auth.token.email == '354245082@educ.dpcdsb.org'
      );
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'username', 'text', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'username', 'avatarBlookId', 'achievements', 'isOwner', 'text', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.username is string && data.username.size() <= 32 &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 300 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'username', 'tokens']) &&
        data.id is string && data.id.size() <= 128 &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 30 &&
        data.tokens is number && data.tokens >= 0;
    }

    // Public lobby chat messages
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        isValidId(messageId) &&
        isValidChatMessage(incoming()) &&
        incoming().userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isSystemAdmin()
      );
    }

    // User account profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().id == userId;
      allow update: if isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isOwner(userId) || isSystemAdmin();
    }
  }
}
