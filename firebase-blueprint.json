{
  "entities": {
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A public chat message sent in the CLICKET Global Lobby",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the message",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user who authored the message",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Display name of the author",
          "maxLength": 32
        },
        "avatarBlookId": {
          "type": "string",
          "description": "Equipped blook ID icon",
          "maxLength": 64
        },
        "achievements": {
          "type": "array",
          "description": "List of unlocked achievements"
        },
        "isOwner": {
          "type": "boolean",
          "description": "Whether the author is the official Clicket Owner"
        },
        "text": {
          "type": "string",
          "description": "Text content of the message",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the message was posted"
        }
      },
      "required": ["id", "userId", "username", "text", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Player account profile and inventory data",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Unique username chosen by the player",
          "maxLength": 30
        },
        "tokens": {
          "type": "number",
          "description": "Player token balance"
        },
        "equippedBlookId": {
          "type": "string",
          "description": "Currently equipped blook ID",
          "maxLength": 64
        },
        "clickUpgradeLevel": {
          "type": "number",
          "description": "Daily clicker upgrade level"
        },
        "bestDailyClicks": {
          "type": "number",
          "description": "Highest clicks record"
        },
        "achievements": {
          "type": "array",
          "description": "Array of achievement badge IDs"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO date-time when account was created"
        }
      },
      "required": ["id", "username", "tokens"]
    },
    "GlobalTrade": {
      "title": "GlobalTrade",
      "description": "Public global trade offer listed on the Global Trading Market",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique trade offer ID",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "creatorId": {
          "type": "string",
          "description": "User ID of the offer creator",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "creatorUsername": {
          "type": "string",
          "description": "Username of the offer creator",
          "maxLength": 30
        },
        "offeredBlookId": {
          "type": "string",
          "description": "Blook ID offered by creator",
          "maxLength": 64
        },
        "requestedBlookId": {
          "type": "string",
          "description": "Specific requested Blook ID (or empty)",
          "maxLength": 64
        },
        "requestedRarity": {
          "type": "string",
          "description": "Requested Blook rarity tier (or empty)",
          "maxLength": 32
        },
        "note": {
          "type": "string",
          "description": "Optional note attached to trade",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "FULFILLED", "CANCELLED"],
          "description": "Current status of the trade listing"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO date-time when trade was posted"
        }
      },
      "required": ["id", "creatorId", "creatorUsername", "offeredBlookId", "status", "createdAt"]
    },
    "PlayerPresence": {
      "title": "PlayerPresence",
      "description": "Real-time online heartbeat presence for active players",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Player presence ID or client ID",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User ID of the player",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Username of the player",
          "maxLength": 32
        },
        "avatarBlookId": {
          "type": "string",
          "description": "Currently equipped Blook ID",
          "maxLength": 64
        },
        "unlockedCount": {
          "type": "number",
          "description": "Number of unique blooks unlocked"
        },
        "isOwner": {
          "type": "boolean",
          "description": "Whether player is official owner"
        },
        "achievements": {
          "type": "array",
          "description": "Array of achievement IDs"
        },
        "lastSeen": {
          "type": "number",
          "description": "Epoch timestamp of last activity heartbeat"
        }
      },
      "required": ["id", "userId", "username", "lastSeen"]
    }
  },
  "firestore": {
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Public lobby chat messages collection"
    },
    "/presence/{playerId}": {
      "schema": "PlayerPresence",
      "description": "Real-time presence collection tracking online players"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual player profiles indexed by user ID"
    },
    "/global_trades/{tradeId}": {
      "schema": "GlobalTrade",
      "description": "Global trading board public listings"
    }
  }
}
